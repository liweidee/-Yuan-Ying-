<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 基础应用配置 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>源影</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>源影</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- 网络放行（允许http） -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- 权限描述（原注释全部保留） -->
    <!-- 相册保存权限 -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>App需要访问相册以保存图片，请允许访问</string>
    <!-- 相机扫码权限 -->
    <key>NSCameraUsageDescription</key>
    <string>需要相机权限以扫描二维码</string>
    <!-- 麦克风语音搜索 -->
    <key>NSMicrophoneUsageDescription</key>
    <string>需要麦克风权限以进行语音搜索</string>
    <!-- 本地网络发现DLNA设备 -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>需要本地网络权限以发现DLNA设备</string>

    <!-- 后台模式（原注释保留，仅保留audio，删除重复配置） -->
    <!-- Node.js 不需要额外的后台模式，仅audio用于保活 -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- 启动配置 -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>

    <!-- 屏幕方向 -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Automatic</string>

    <!-- URL Scheme -->
    <!-- http/https 通用唤起 -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>https</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>http</string>
                <string>https</string>
            </array>
        </dict>
        <!-- yuanying 全量域名回调支持 -->
        <dict>
            <key>CFBundleURLName</key>
            <string>yuanying</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>yuanying</string>
                <string>yuanying://</string>
            </array>
        </dict>
    </array>

    <!-- DLNA 服务 -->
    <!-- 局域网投屏发现 -->
    <key>NSBonjourServices</key>
    <array>
        <string>_http._tcp.</string>
        <string>_dlna._tcp.</string>
    </array>
</dict>
</plist>